{{- /* ─────────────────────────────────────────────────────
     TRMNL Plugin: Tokyo Transit + Weather
     Polling URL: https://airlinedesign.github.io/TRMNL/api/data.json
     Refresh:     Every 5 minutes
     Layout:      Full screen
──────────────────────────────────────────────────── */ -}}

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body, .trmnl {
    font-family: "Inter", sans-serif;
    background: #fff;
    color: #000;
    width: 800px;
    height: 480px;
    overflow: hidden;
  }

  .screen {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    height: 100%;
    padding: 18px 36px 14px 20px;
    gap: 12px;
  }

  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid #000;
    padding-bottom: 8px;
  }

  .header__title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .header__updated {
    font-size: 11px;
    opacity: 0.4;
  }

  .trains-line {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .trains-line__primary {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .trains-line__sep {
    font-size: 22px;
    opacity: 0.25;
    font-weight: 300;
  }

  .trains-line__next {
    font-size: 20px;
    font-weight: 500;
    opacity: 0.5;
  }

  .bus-line {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .bus-line__primary {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    opacity: 0.75;
  }

  .bus-line__sep {
    font-size: 16px;
    opacity: 0.2;
    font-weight: 300;
  }

  .bus-line__next {
    font-size: 16px;
    font-weight: 500;
    opacity: 0.4;
  }

  .bus-line__label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.35;
  }

  .weather {
    display: flex;
    align-items: center;
    border-top: 1.5px solid #000;
    padding-top: 14px;
    gap: 28px;
  }

  .weather__icon {
    font-size: 96px;
    line-height: 1;
    flex-shrink: 0;
  }

  .weather__temp-block {
    flex-shrink: 0;
  }

  .weather__temp {
    font-size: 80px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .weather__desc {
    font-size: 14px;
    opacity: 0.5;
    margin-top: 4px;
  }

  .weather__stats {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-left: auto;
  }

  .weather__stat {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .weather__stat-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.4;
    font-weight: 600;
    width: 72px;
  }

  .weather__stat-value {
    font-size: 24px;
    font-weight: 600;
    line-height: 1;
  }
</style>

<div class="screen">

  <div class="header">
    <span class="header__title">
      沼袋 → 西武新宿 &nbsp;·&nbsp; Seibu Shinjuku Line
    </span>
    <span class="header__updated">
      {{ generated_at }} &nbsp;·&nbsp; {{ day_type }}
    </span>
  </div>

  <div class="trains-line">
    <span class="trains-line__primary">{{ trains[0].leave_display }}</span>
    <span class="trains-line__sep">·</span>
    <span class="trains-line__next">{{ trains[1].next_display }}</span>
  </div>

  <div class="bus-line">
    <span class="bus-line__label">中12</span>
    <span class="bus-line__primary">{{ bus_display }}</span>
    <span class="bus-line__sep">·</span>
    <span class="bus-line__next">{{ bus_next }}</span>
  </div>

  <div class="weather">
    <div class="weather__icon">{{ weather_icon }}</div>
    <div class="weather__temp-block">
      <div class="weather__temp">{{ weather.temp_c }}°</div>
      <div class="weather__desc">{{ weather.description }} · feels {{ weather.feels_like_c }}°</div>
    </div>
    <div class="weather__stats">
      <div class="weather__stat">
        <span class="weather__stat-label">High</span>
        <span class="weather__stat-value">{{ weather.high_c }}°</span>
      </div>
      <div class="weather__stat">
        <span class="weather__stat-label">Low</span>
        <span class="weather__stat-value">{{ weather.low_c }}°</span>
      </div>
      <div class="weather__stat">
        <span class="weather__stat-label">Humidity</span>
        <span class="weather__stat-value">{{ weather.humidity_pct }}%</span>
      </div>
    </div>
  </div>

</div>
