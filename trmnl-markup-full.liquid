<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body, .trmnl {
    font-family: "Inter", sans-serif;
    background: #fff;
    color: #000;
    width: 800px;
    height: 480px;
    overflow: hidden;
  }

  .screen {
    display: grid;
    grid-template-rows: 1fr 1fr 1fr 1fr;
    height: 100%;
    padding: 16px 48px 16px 24px;
  }

  /* ── Header ── */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .date {
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .date-ordinal {
    font-size: 22px;
    font-weight: 700;
    vertical-align: super;
  }

  .last-update {
    font-size: 13px;
    opacity: 0.4;
  }

  /* ── Transit rows ── */
  .transit-row {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .transit-icon {
    flex-shrink: 0;
    width: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .transit-info {
    flex: 1;
  }

  .transit-label {
    font-size: 12px;
    opacity: 0.45;
    margin-bottom: 5px;
  }

  .transit-times {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .time-primary {
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .time-sep {
    font-size: 26px;
    font-weight: 300;
    opacity: 0.2;
  }

  .time-secondary {
    font-size: 26px;
    font-weight: 500;
    opacity: 0.5;
  }

  /* ── Weather ── */
  .weather-row {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .weather-icon-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-right: 28px;
    flex-shrink: 0;
  }

  .weather-icon {
    font-size: 48px;
    line-height: 1;
  }

  .weather-label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    opacity: 0.45;
  }

  .weather-stat {
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
    padding-left: 16px;
    border-left: 1px solid rgba(0,0,0,0.1);
  }

  .weather-stat:first-of-type {
    border-left: none;
    padding-left: 0;
  }

  .stat-label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.38;
  }

  .stat-value {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .stat-value .slash {
    font-size: 20px;
    font-weight: 300;
    opacity: 0.35;
  }

  .stat-value .low {
    font-size: 22px;
    font-weight: 700;
    opacity: 0.55;
  }
</style>

<div class="screen">

  <div class="header">
    <div class="date">{{ date_main }}<span class="date-ordinal">{{ date_ordinal }}</span></div>
    <div class="last-update">Last update {{ last_update }}</div>
  </div>

  <div class="transit-row">
    <div class="transit-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="50" height="60" viewBox="0 0 50 60">
        <rect x="2" y="2" width="46" height="46" rx="10" fill="#000"/>
        <rect x="7" y="9" width="14" height="15" rx="4" fill="#fff"/>
        <rect x="29" y="9" width="14" height="15" rx="4" fill="#fff"/>
        <circle cx="25" cy="35" r="5" fill="#fff"/>
        <rect x="5" y="44" width="40" height="4" rx="2" fill="#fff" opacity="0.25"/>
        <rect x="1" y="50" width="48" height="6" rx="3" fill="#000"/>
        <rect x="5" y="54" width="10" height="6" rx="2" fill="#000"/>
        <rect x="35" y="54" width="10" height="6" rx="2" fill="#000"/>
      </svg>
    </div>
    <div class="transit-info">
      <div class="transit-label">沼袋駅 Seibu-Shinjuku line to Shinjuku Station</div>
      <div class="transit-times">
        <span class="time-primary">{{ train_display }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ train_time2 }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ train_time3 }}</span>
      </div>
    </div>
  </div>

  <div class="transit-row">
    <div class="transit-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="50" height="60" viewBox="0 0 50 60">
        <rect x="2" y="1" width="46" height="46" rx="7" fill="#000"/>
        <rect x="7" y="7" width="36" height="15" rx="4" fill="#fff"/>
        <rect x="7" y="27" width="16" height="13" rx="3" fill="#fff"/>
        <rect x="27" y="27" width="16" height="13" rx="3" fill="#fff"/>
        <rect x="0" y="47" width="50" height="5" rx="2" fill="#000"/>
        <circle cx="12" cy="55" r="5" fill="#000"/>
        <circle cx="38" cy="55" r="5" fill="#000"/>
        <circle cx="12" cy="55" r="2" fill="#fff"/>
        <circle cx="38" cy="55" r="2" fill="#fff"/>
      </svg>
    </div>
    <div class="transit-info">
      <div class="transit-label">哲学堂公園 Bus to Nakano Station</div>
      <div class="transit-times">
        <span class="time-primary">{{ bus_display }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ bus_time2 }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ bus_time3 }}</span>
      </div>
    </div>
  </div>

  <div class="weather-row">
    <div class="weather-icon-block">
      <span class="weather-icon">{{ weather_icon }}</span>
      <span class="weather-label">{{ weather_label }}</span>
    </div>
    <div class="weather-stat">
      <div class="stat-label">CURRENTLY</div>
      <div class="stat-value">{{ temp_c }}°</div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">HIGH / LOW</div>
      <div class="stat-value">{{ high_c }}°<span class="slash">/</span><span class="low">{{ low_c }}°</span></div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">HUMIDITY</div>
      <div class="stat-value">{{ humidity_pct }}%</div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">RAIN</div>
      <div class="stat-value">{{ rain_pct }}%</div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">FEELS LIKE</div>
      <div class="stat-value">{{ feels_like_c }}°</div>
    </div>
  </div>

</div>
