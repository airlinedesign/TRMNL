<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body, .trmnl {
    font-family: "Inter", sans-serif;
    background: #fff;
    color: #000;
    width: 800px;
    height: 480px;
    overflow: hidden;
  }

  .screen {
    display: grid;
    grid-template-rows: 1fr 1fr 1fr 1fr;
    grid-template-columns: 1fr;
    align-items: center;
    height: 100%;
    padding: 16px 56px 16px 24px;
  }

  /* ── Header ── */
  .header {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .date {
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .date-ordinal {
    font-size: 22px;
    font-weight: 700;
    vertical-align: super;
  }

  .last-update {
    font-size: 15px;
    opacity: 0.4;
  }

  /* ── Transit rows ── */
  .transit-row {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .transit-icon {
    flex-shrink: 0;
    width: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .transit-info {
    flex: 1;
  }

  .transit-label {
    font-size: 15px;
    opacity: 0.45;
  }

  .transit-note {
    font-size: 12px;
    opacity: 0.3;
    margin-bottom: 5px;
  }

  .transit-times {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .time-primary {
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .time-sep {
    font-size: 26px;
    font-weight: 300;
    opacity: 0.2;
  }

  .time-secondary {
    font-size: 20px;
    font-weight: 500;
    opacity: 0.5;
    white-space: nowrap;
  }

  /* ── Weather ── */
  .weather-row {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .weather-icon-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-right: 28px;
    flex-shrink: 0;
  }

  .weather-icon {
    font-size: 48px;
    line-height: 1;
  }

  .weather-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    opacity: 0.45;
  }

  .weather-stat {
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
    padding-left: 16px;
    border-left: 1px solid rgba(0,0,0,0.1);
  }

  .weather-stat:first-of-type {
    border-left: none;
    padding-left: 0;
  }

  .stat-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.38;
  }

  .stat-value {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .stat-value .slash {
    font-size: 20px;
    font-weight: 300;
    opacity: 0.35;
  }

  .stat-value .low {
    font-size: 20px;
    font-weight: 700;
    opacity: 0.55;
    vertical-align: middle;
  }
</style>

<div class="screen">

  <div class="header">
    <div class="date">{{ date_main }}<span class="date-ordinal">{{ date_ordinal }}</span></div>
    <div class="last-update">Last update {{ last_update }}</div>
  </div>

  <div class="transit-row">
    <div class="transit-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="78" height="89" viewBox="0 0 78 89" fill="none">
        <path d="M58.5001 0C63.4707 0 67.5001 4.02944 67.5001 9V61C67.5001 62.1046 66.6047 63 65.5001 63H12.5001C11.3956 63 10.5001 62.1046 10.5001 61V9C10.5001 4.02944 14.5296 0 19.5001 0H58.5001ZM17.0001 49C15.0671 49 13.5001 50.567 13.5001 52.5C13.5001 54.433 15.0671 56 17.0001 56C18.9331 56 20.5001 54.433 20.5001 52.5C20.5001 50.567 18.9331 49 17.0001 49ZM60.0001 49C58.0671 49 56.5001 50.567 56.5001 52.5C56.5001 54.433 58.0671 56 60.0001 56C61.9331 56 63.5001 54.433 63.5001 52.5C63.5001 50.567 61.9331 49 60.0001 49ZM20.5001 14C18.291 14 16.5001 15.7909 16.5001 18V32C16.5001 34.2091 18.291 36 20.5001 36H58.5001C60.7093 36 62.5001 34.2091 62.5001 32V18C62.5001 15.7909 60.7093 14 58.5001 14H20.5001ZM33.5001 4C32.3956 4 31.5001 4.89543 31.5001 6C31.5001 7.10457 32.3956 8 33.5001 8H45.5001C46.6047 8 47.5001 7.10457 47.5001 6C47.5001 4.89543 46.6047 4 45.5001 4H33.5001Z" fill="black"/>
        <path d="M39.0001 40L2.50012 86" stroke="black" stroke-width="5" stroke-linecap="round"/>
        <path d="M39.0001 40L75.5001 86" stroke="black" stroke-width="5" stroke-linecap="round"/>
        <path d="M7.71442 80L70.2858 80" stroke="black" stroke-width="5"/>
        <path d="M16.5787 67H61.4215" stroke="black" stroke-width="5"/>
      </svg>
    </div>
    <div class="transit-info">
      <div class="transit-label">沼袋駅 Seibu-Shinjuku line to Shinjuku Station</div>
      <div class="transit-note">timing includes {{ walk_minutes }} minute walk to station</div>
      <div class="transit-times">
        <span class="time-primary">{{ train_display }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ train_time2 }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ train_time3 }}</span>
      </div>
    </div>
  </div>

  <div class="transit-row">
    <div class="transit-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="46" height="58" viewBox="0 0 57 73" fill="none">
        <path d="M48 0C52.9706 0 57 4.02944 57 9V54C57 58.9706 52.9706 63 48 63H9C4.02944 63 2.17444e-07 58.9706 0 54V9C0 4.02944 4.02944 0 9 0H48ZM12 46C9.23858 46 7 48.2386 7 51C7 53.7614 9.23858 56 12 56C14.7614 56 17 53.7614 17 51C17 48.2386 14.7614 46 12 46ZM44 46C41.2386 46 39 48.2386 39 51C39 53.7614 41.2386 56 44 56C46.7614 56 49 53.7614 49 51C49 48.2386 46.7614 46 44 46ZM8 11C5.79086 11 4 12.7909 4 15V32C4 34.2091 5.79086 36 8 36H49C51.2091 36 53 34.2091 53 32V15C53 12.7909 51.2091 11 49 11H8ZM13 4C11.8954 4 11 4.89543 11 6C11 7.10457 11.8954 8 13 8H45C46.1046 8 47 7.10457 47 6C47 4.89543 46.1046 4 45 4H13Z" fill="black"/>
        <path d="M7 62H16V70C16 71.6569 14.6569 73 13 73H10C8.34315 73 7 71.6569 7 70V62Z" fill="black"/>
        <path d="M40 62H49V70C49 71.6569 47.6569 73 46 73H43C41.3431 73 40 71.6569 40 70V62Z" fill="black"/>
      </svg>
    </div>
    <div class="transit-info">
      <div class="transit-label">下田橋 Bus to Nakano Station</div>
      <div class="transit-note">timing includes {{ walk_to_bus }} minute walk to bus stop</div>
      <div class="transit-times">
        <span class="time-primary">{{ bus_display }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ bus_time2 }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ bus_time3 }}</span>
      </div>
    </div>
  </div>

  <div class="weather-row">
    <div class="weather-icon-block">
      <span class="weather-icon">{{ weather_icon }}</span>
      <span class="weather-label">{{ weather_label }}</span>
    </div>
    <div class="weather-stat">
      <div class="stat-label">CURRENTLY</div>
      <div class="stat-value">{{ temp_c }}°</div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">HIGH / LOW</div>
      <div class="stat-value">{{ high_c }}°<span class="slash">/</span><span class="low">{{ low_c }}°</span></div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">HUMIDITY</div>
      <div class="stat-value">{{ humidity_pct }}%</div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">RAIN</div>
      <div class="stat-value">{{ rain_pct }}%</div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">FEELS LIKE</div>
      <div class="stat-value">{{ feels_like_c }}°</div>
    </div>
  </div>

</div>
