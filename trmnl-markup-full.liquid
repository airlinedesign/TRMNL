<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body, .trmnl {
    font-family: "Inter", sans-serif;
    background: #fff;
    color: #000;
    width: 800px;
    height: 480px;
    overflow: hidden;
  }

  .screen {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 20px 28px 16px 24px;
    gap: 0;
  }

  /* ── Header ── */
  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 14px;
  }

  .date {
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .date-ordinal {
    font-size: 24px;
    font-weight: 700;
    vertical-align: super;
  }

  .last-update {
    font-size: 13px;
    opacity: 0.45;
    align-self: flex-end;
    padding-bottom: 6px;
  }

  /* ── Transit rows ── */
  .transit-row {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 14px 0;
  }

  .transit-icon {
    flex-shrink: 0;
    width: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .transit-info {
    flex: 1;
  }

  .transit-label {
    font-size: 12px;
    opacity: 0.5;
    margin-bottom: 4px;
  }

  .transit-times {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .time-primary {
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: capitalize;
  }

  .time-sep {
    font-size: 28px;
    font-weight: 300;
    opacity: 0.25;
  }

  .time-secondary {
    font-size: 28px;
    font-weight: 500;
    opacity: 0.55;
  }

  /* ── Weather ── */
  .weather-row {
    display: flex;
    align-items: center;
    gap: 0;
    padding-top: 14px;
    margin-top: auto;
  }

  .weather-icon-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    margin-right: 28px;
    flex-shrink: 0;
  }

  .weather-icon {
    font-size: 52px;
    line-height: 1;
  }

  .weather-label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    opacity: 0.5;
  }

  .weather-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    padding-left: 16px;
    border-left: 1px solid rgba(0,0,0,0.12);
  }

  .weather-stat:first-of-type {
    border-left: none;
    padding-left: 0;
  }

  .stat-label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.4;
  }

  .stat-value {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .stat-value .low {
    font-size: 18px;
    font-weight: 700;
    opacity: 0.6;
  }

  .stat-value .slash {
    font-size: 22px;
    font-weight: 300;
    opacity: 0.4;
  }
</style>

<div class="screen">

  <div class="header">
    <div class="date">{{ date_main }}<span class="date-ordinal">{{ date_ordinal }}</span></div>
    <div class="last-update">Last update {{ last_update }}</div>
  </div>

  <div class="transit-row">
    <div class="transit-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="52" height="62" viewBox="0 0 52 62">
        <rect x="2" y="4" width="48" height="44" rx="8" fill="#000"/>
        <rect x="7" y="11" width="15" height="12" rx="3" fill="#fff"/>
        <rect x="30" y="11" width="15" height="12" rx="3" fill="#fff"/>
        <rect x="7" y="30" width="38" height="3" fill="#fff" opacity="0.35"/>
        <circle cx="26" cy="38" r="4" fill="#fff"/>
        <rect x="0" y="50" width="52" height="7" rx="3" fill="#000"/>
        <rect x="5" y="55" width="10" height="7" rx="2" fill="#000"/>
        <rect x="37" y="55" width="10" height="7" rx="2" fill="#000"/>
      </svg>
    </div>
    <div class="transit-info">
      <div class="transit-label">沼袋駅 Seibu-Shinjuku line to Shinjuku Station</div>
      <div class="transit-times">
        <span class="time-primary">{{ train_display }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ train_time2 }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ train_time3 }}</span>
      </div>
    </div>
  </div>

  <div class="transit-row">
    <div class="transit-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="52" height="62" viewBox="0 0 52 62">
        <rect x="2" y="2" width="48" height="48" rx="7" fill="#000"/>
        <rect x="7" y="8" width="38" height="14" rx="3" fill="#fff"/>
        <rect x="7" y="28" width="17" height="12" rx="2" fill="#fff"/>
        <rect x="28" y="28" width="17" height="12" rx="2" fill="#fff"/>
        <circle cx="13" cy="56" r="6" fill="#000"/>
        <circle cx="39" cy="56" r="6" fill="#000"/>
        <circle cx="13" cy="56" r="3" fill="#fff"/>
        <circle cx="39" cy="56" r="3" fill="#fff"/>
      </svg>
    </div>
    <div class="transit-info">
      <div class="transit-label">哲学堂公園 Bus to Nakano Station</div>
      <div class="transit-times">
        <span class="time-primary">{{ bus_display }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ bus_time2 }}</span>
        <span class="time-sep">|</span>
        <span class="time-secondary">{{ bus_time3 }}</span>
      </div>
    </div>
  </div>

  <div class="weather-row">
    <div class="weather-icon-block">
      <span class="weather-icon">{{ weather_icon }}</span>
      <span class="weather-label">{{ weather_label }}</span>
    </div>
    <div class="weather-stat">
      <div class="stat-label">CURRENTLY</div>
      <div class="stat-value">{{ temp_c }}°</div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">HIGH / LOW</div>
      <div class="stat-value">{{ high_c }}°<span class="slash">/</span><span class="low">{{ low_c }}°</span></div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">HUMIDITY</div>
      <div class="stat-value">{{ humidity_pct }}%</div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">RAIN</div>
      <div class="stat-value">{{ rain_pct }}%</div>
    </div>
    <div class="weather-stat">
      <div class="stat-label">FEELS LIKE</div>
      <div class="stat-value">{{ feels_like_c }}°</div>
    </div>
  </div>

</div>
